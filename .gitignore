# =============================================================================
# AI CODING ASSISTANTS
# =============================================================================

# --- Claude Code (Anthropic) ---
# Commit:    CLAUDE.md, .claude/settings.json, .claude/commands/, .claude/rules/
# Gitignore: local overrides and session state
CLAUDE.local.md
.claude/settings.local.json
.claude/todos/
.claude/.last_session

# --- GitHub Copilot ---
# Commit: .github/copilot-instructions.md, .github/instructions/
# Nothing typically gitignored; Copilot has no local state files

# --- Cursor ---
# Commit:    .cursor/rules/*.mdc
# Gitignore: legacy rules file and local overrides
.cursorrules
.cursorignore
.cursorindexingignore
.cursor/mcp.json

# --- Windsurf (Codeium) ---
# Commit:    .windsurf/rules/
# Gitignore: legacy file and local ignore
.windsurfrules
.codeiumignore

# --- Gemini CLI (Google) ---
GEMINI.local.md
.geminiignore
.aiexclude

# --- OpenAI Codex CLI ---
# AGENTS.md is typically committed; local overrides below
AGENTS.local.md
.codex/

# --- Aider ---
.aider*
!.aiderignore
.aider.tags.cache.v*/

# --- Cline / Roo Code ---
.clinerules.local
.roo/mcp.json

# --- Continue.dev ---
.continue/config.local.json

# --- General AI tool artifacts ---
.aiignore
*.ai-session
.ai-context/


