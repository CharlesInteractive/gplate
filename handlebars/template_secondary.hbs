
   <ul class="list-unstyled">
        {{#each persons}}
            <li class="rounded-sm mg-b-sm bg-c-gray-light pd-sm">
                <h4>Index: {{@index}}</h4>
                <p>Hi, my name is <strong>{{properties.name}}</strong> and I am {{article properties.occupation}} {{properties.occupation}}. I know {{listJoin properties.skills}}.</p>
            </li>
        {{/each}}
   </ul>